# model-hub server configuration.
# Copy to apps/hub/.env.local (gitignored) and fill in real values.
# Never commit real secrets, logs, or build artifacts containing them.

# Master key used for envelope encryption (AES-256-GCM, W1-3).
# Generate a strong value with:
#   openssl rand -base64 32
HUB_MASTER_KEY=

# Owner (full-access) console username (default: owner).
HUB_OWNER_USERNAME=owner

# Password for the owner console login.
# Generate with:
#   openssl rand -base64 24
HUB_ADMIN_PASSWORD=

# Operator (read-only) console username (default: operator).
HUB_OPERATOR_USERNAME=operator

# Operator password; leave blank to disable the operator account.
HUB_OPERATOR_PASSWORD=

# TCP port the HTTP server binds (default 8791).
HUB_PORT=8791

# Directory for the SQLite database, encrypted key material and cached
# projections (default ./data). Created on boot with 0700 permissions;
# sensitive files inside are written 0600.
HUB_DATA_DIR=./data

# Set to 1 only for local development on localhost to disable admin auth.
# Never enable on a shared or network-facing host.
HUB_DEV_NO_AUTH=0

# --- Knowledge base (F3/M3, optional) ---
# The knowledge subdomain embeds documents through the hub's own assigned
# models. It acts as a consumer of this hub via model-kit, so it needs a
# project token of a project that has the embedding (and optional text)
# aliases assigned. Leave KNOWLEDGE_PROJECT_TOKEN unset to disable
# knowledge ingest/query entirely.

# Base URL used to pull the catalog and report usage (defaults to this
# hub itself over loopback).
# KNOWLEDGE_HUB_URL=http://127.0.0.1:8791

# Project token (mh_...) of the consumer project owning the aliases below.
# KNOWLEDGE_PROJECT_TOKEN=

# Embedding alias for document/query vectors (default: embed).
# KNOWLEDGE_EMBED_ALIAS=embed

# Text alias used to rerank vector hits before answering. Unset = keep the
# pure vector order.
# KNOWLEDGE_RERANK_ALIAS=

# Text alias used to synthesize grounded answers with citations. Unset =
# query returns citations only.
# KNOWLEDGE_ANSWER_ALIAS=
