{
  "name": "@model-hub/model-kit",
  "version": "0.2.0",
  "private": true,
  "description": "Project-side client for model-hub: pull and cache the projected catalog, resolve models by alias/modality/role, run L3/L4 connection tests, and report usage.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepare": "node -e \"const fs=require('fs'); if(fs.existsSync('tsconfig.build.json')){require('child_process').execSync('tsc -p tsconfig.build.json',{stdio:'inherit'})}\""
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.2",
    "typescript": "^5.7.2"
  }
}
